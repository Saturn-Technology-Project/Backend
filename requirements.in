# Production dependencies. Edit this file, then regenerate both hashed locks
# (EXCLUDE_NEWER is a date about two weeks before today, so a release that was
# published hours ago and later yanked as malicious is never picked up):
#
#   uv pip compile requirements.in --universal --python-version 3.12 \
#     --generate-hashes --exclude-newer "$EXCLUDE_NEWER" -o requirements.txt
#   uv pip compile requirements-dev.in --universal --python-version 3.12 \
#     --generate-hashes --exclude-newer "$EXCLUDE_NEWER" -o requirements-dev.txt
# For security fixes released within that window, include in both commands:
#   --exclude-newer-package pyasn1=2026-11-04T00:00:00Z
#   --exclude-newer-package pydantic=2026-10-30T00:00:00Z
#   --exclude-newer-package pydantic-core=2026-10-30T00:00:00Z
# (pydantic 2.14.2 fixes GHSA-qpmf-fgh3-ff25 and GHSA-3r8g-cqwr-jr29.)
#
# Install with `pip install --require-hashes -r requirements.txt`.
# Test-only packages live in requirements-dev.in.
