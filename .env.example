DATABASE_URL=postgresql+asyncpg://saturn:saturn@localhost:5432/saturn
REDIS_URL=redis://localhost:6379/0
DEFAULT_ORG_ID=org_saturn
DEFAULT_ACTOR_ID=user_operator
# Required to create the first platform admin. Leave empty to skip seeding.
SEED_USER_EMAIL=
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=
SESSION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Absolute backend origin for Connector/runtime enroll URLs, e.g.
# https://saturn-backend-xxxxx.run.app  (converted to wss://)
# PUBLIC_WS_URL=
# Leave unset/false in production. Tests set this so the policy loop can run without a live Agent.
# IN_PROCESS_RUNTIME=false
