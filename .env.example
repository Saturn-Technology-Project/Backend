# Local development. Copy to .env and fill in the blanks. Never commit .env.

# docker compose reads these two for the Postgres and Redis containers it
# starts, and builds the api container's DATABASE_URL / REDIS_URL from them.
# Generate each with: openssl rand -hex 16
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Used when the API runs on the host (uvicorn / pytest) against the compose
# containers, which listen on 127.0.0.1:5433 and 127.0.0.1:6379. Put the same
# passwords here. Inside compose, the api service overrides both.
DATABASE_URL=postgresql+asyncpg://saturn:POSTGRES_PASSWORD@localhost:5433/saturn
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
DEFAULT_ORG_ID=org_saturn
DEFAULT_ACTOR_ID=user_operator
# Required to create the first platform admin. Leave empty to skip seeding.
SEED_USER_EMAIL=
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=
SESSION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dashboard.saturn-core.com
# Public origin of this API. MCP OAuth callbacks use ${PUBLIC_WS_URL}/mcp-servers/oauth/callback.
# Production is https://api.saturn-core.com.
# PUBLIC_WS_URL=https://api.saturn-core.com
# GitHub OAuth App callback must be exactly ${PUBLIC_WS_URL}/mcp-servers/oauth/callback
# Google OAuth client redirect URI is the same callback.
# SATURN_GOOGLE_OAUTH_CLIENT_ID=
# SATURN_GOOGLE_OAUTH_CLIENT_SECRET=
# Leave unset/false in production. Tests set this so the policy loop can run without a live Agent.
# IN_PROCESS_RUNTIME=false
# ISO date (YYYY-MM-DD). After it, legacy (pre-argon2) passwords can no longer sign in.
# Empty means they are accepted with no end date.
# LEGACY_PASSWORD_UNTIL=
# The container runs `alembic upgrade head` on start unless this is "false".
# Production sets it to false when migrations run in a Cloud Run Job.
# RUN_MIGRATIONS=true
# How long a migration waits for another runner's advisory lock (Postgres interval).
# MIGRATION_LOCK_WAIT=300s
