# Test and local-development dependencies. Never installed in the production image.
# Regenerate the hashed locks after editing this file or requirements.in; the
# commands are at the top of requirements.in. requirements-dev.txt is resolved
# against requirements.txt, so CI tests the exact production versions.
#
# Install with `pip install --require-hashes -r requirements-dev.txt`.
-c requirements.txt
-r requirements.in
pytest==9.2.0
pytest-asyncio==1.4.1.post1
# 0.22 keeps its worker threads alive at interpreter exit: the suite passes and then waits about
# five minutes before the process ends. Stay on 0.21 until the test engine setup is changed for it.
aiosqlite==0.21.0
